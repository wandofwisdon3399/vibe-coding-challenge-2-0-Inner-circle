# Copy this file to ".env" for local development. NEVER commit the real .env.
# On Render, enter these same names in the Environment tab instead.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sportsync?retryWrites=true&w=majority

# Long random string used to sign login tokens (generate one, see README)
JWT_SECRET=change-me-to-a-long-random-string

# Secret key required to create the first Admin account
ADMIN_SETUP_KEY=change-me-to-another-long-random-string

# Local development: leave as is. On Render set NODE_ENV=production
NODE_ENV=development
PORT=5000

# Production only: your Vercel site address, e.g. https://my-academy.vercel.app
# (comma-separate several). Not needed locally.
CLIENT_ORIGIN=
